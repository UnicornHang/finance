# ==============================================
# 生产环境模板 → 复制为 .env.prod 后填写真实密钥
#   cp .env.prod.example .env.prod
# 切勿把 .env.prod 提交到 Git
# ==============================================

APP_NAME=finance-ai-agent
APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Nginx 宿主机端口
HTTP_PORT=80
HTTPS_PORT=443

# Gunicorn worker 数（建议 ≈ CPU 核数）
BACKEND_WORKERS=2
API_V1_PREFIX=/api/v1

# 前端构建时 API 前缀；留空 = 同源相对路径 /api/v1（推荐）
VITE_API_BASE_URL=

# CORS：JSON 数组。同源经 Nginx 时填对外访问源即可
# 启用 HTTPS 后改为 ["https://your.domain.com"]
CORS_ORIGINS=["http://localhost"]

# ==============================================
# 数据库（密码务必改为强随机串，并同步 DATABASE_URL）
# ==============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=finance
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=finance
DATABASE_URL=postgresql+asyncpg://finance:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/finance

# ==============================================
# Redis / Celery
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ==============================================
# MinIO（业务对象存储）
# ==============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
# 格式 name:base64(32字节)；部署脚本可自动生成
MINIO_KMS_SECRET_KEY=REPLACE_WITH_KMS_NAME_AND_BASE64_KEY
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET_INVOICE=invoices
MINIO_BUCKET_CONTRACT=contracts
MINIO_BUCKET_KB=knowledge-base
MINIO_BUCKET_EXPORTS=exports

# Milvus 内部专用 MinIO（不对公网暴露，仍建议改默认口令）
MILVUS_MINIO_ACCESS_KEY=REPLACE_MILVUS_MINIO_USER
MILVUS_MINIO_SECRET_KEY=REPLACE_MILVUS_MINIO_PASSWORD

# ==============================================
# JWT / 字段加密（部署脚本可自动生成）
# ==============================================
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# ==============================================
# LLM（必填，否则对话/识别失败）
# ==============================================
LLM_CHITCHAT_MODEL=gpt-4o-mini
LLM_CHITCHAT_API_KEY=
LLM_CHITCHAT_BASE_URL=https://api.openai.com/v1

LLM_POLICY_MODEL=gpt-4o
LLM_POLICY_API_KEY=
LLM_POLICY_BASE_URL=https://api.openai.com/v1

LLM_OCR_MODEL=gpt-4o
LLM_OCR_API_KEY=
LLM_OCR_BASE_URL=https://api.openai.com/v1

LLM_CONTRACT_MODEL=gpt-4o
LLM_CONTRACT_API_KEY=
LLM_CONTRACT_BASE_URL=https://api.openai.com/v1

OCR_PROVIDER=tencent
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_FETCH_PAGES=2
WEB_SEARCH_FETCH_MAX_CHARS=4000

EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

RAG_HYBRID_ENABLED=true
RAG_RETRIEVE_MULTIPLIER=4
RAG_RRF_K=60
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=20
RERANK_PROVIDER=dashscope
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_TIMEOUT=15
RERANK_MAX_DOC_CHARS=4000

MILVUS_ENABLED=true
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=finance_kb_chunks
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024
MILVUS_NPROBE=16
KB_STORE_PG_EMBEDDING=false

OBSERVE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

RATE_LIMIT_PER_USER=100/minute
RATE_LIMIT_PER_TENANT=10000/hour
RATE_LIMIT_PER_IP=1000/minute

# 监控 profile（--profile monitoring）
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
