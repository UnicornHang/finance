# ==============================================
# 通用配置
# ==============================================
APP_NAME=finance-ai-agent
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ==============================================
# 后端 API
# ==============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
API_V1_PREFIX=/api/v1

# ==============================================
# 前端
# ==============================================
FRONTEND_PORT=5173
# 留空 = 走相对路径（同源，推荐 nginx 80 端口访问）
# 若需直连后端 8000 端口，填 http://localhost:8000/api/v1
VITE_API_BASE_URL=
# 容器内 vite dev server 代理目标。Docker 部署时填 http://backend:8000；
# 本机直跑（npm run dev）留空，自动 fallback 到 http://localhost:8000
VITE_API_PROXY_TARGET=

# ==============================================
# 数据库
# ==============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_pass_change_me
POSTGRES_DB=finance
DATABASE_URL=postgresql+asyncpg://finance:finance_pass_change_me@postgres:5432/finance

# ==============================================
# Redis
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ==============================================
# MinIO 对象存储
# ==============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass_change_me
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_INVOICE=invoices
MINIO_BUCKET_CONTRACT=contracts
MINIO_BUCKET_KB=knowledge-base

# ==============================================
# JWT / 安全
# ==============================================
JWT_SECRET=please-change-this-to-a-32-char-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=please-change-this-to-a-32-byte-base64-key

# ==============================================
# LLM（LiteLLM 格式）
# ==============================================
# 场景：chitchat / policy_query / ocr_post / contract_review
LLM_CHITCHAT_MODEL=gpt-4o-mini
LLM_CHITCHAT_API_KEY=
LLM_CHITCHAT_BASE_URL=https://api.openai.com/v1

LLM_POLICY_MODEL=gpt-4o
LLM_POLICY_API_KEY=
LLM_POLICY_BASE_URL=https://api.openai.com/v1

LLM_OCR_MODEL=gpt-4o
LLM_OCR_API_KEY=
LLM_OCR_BASE_URL=https://api.openai.com/v1

LLM_CONTRACT_MODEL=gpt-4o
LLM_CONTRACT_API_KEY=
LLM_CONTRACT_BASE_URL=https://api.openai.com/v1

# ==============================================
# OCR
# ==============================================
OCR_PROVIDER=tencent
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# ==============================================
# Embedding
# ==============================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536

# ==============================================
# Celery
# ==============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ==============================================
# Langfuse（可选）
# ==============================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ==============================================
# 限流
# ==============================================
RATE_LIMIT_PER_USER=100/minute
RATE_LIMIT_PER_TENANT=10000/hour
RATE_LIMIT_PER_IP=1000/minute

# ==============================================
# 监控
# ==============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=grafana_admin_change_me