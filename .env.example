# ==============================================
# 通用配置
# ==============================================
APP_NAME=finance-ai-agent
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ==============================================
# 后端 API
# ==============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
API_V1_PREFIX=/api/v1

# ==============================================
# 前端
# ==============================================
FRONTEND_PORT=5173
# 留空 = 走相对路径（同源，推荐 nginx 80 端口访问）
# 若需直连后端 8000 端口，填 http://localhost:8000/api/v1
VITE_API_BASE_URL=
# 容器内 vite dev server 的代理目标（只在前端 dev server 场景生效）
# - Docker 全套部署：留空即可，docker-compose.yml 里前端服务已显式设为 http://backend:8000
# - 后端跑虚拟机、前端在 Windows 本机 npm run dev：必须填 http://<VM-IP>:8000
#   （推荐写进 frontend/.env.local，该文件已被 .gitignore 覆盖）
# - 后端跑 Windows 本机：留空，vite.config.ts 会 fallback 到 http://127.0.0.1:8000
VITE_API_PROXY_TARGET=

# ==============================================
# 数据库
# ==============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_pass_change_me
POSTGRES_DB=finance
DATABASE_URL=postgresql+asyncpg://finance:finance_pass_change_me@postgres:5432/finance

# ==============================================
# Redis
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ==============================================
# MinIO 对象存储
# ==============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass_change_me
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_INVOICE=invoices
MINIO_BUCKET_CONTRACT=contracts
MINIO_BUCKET_KB=knowledge-base

# ==============================================
# JWT / 安全
# ==============================================
JWT_SECRET=please-change-this-to-a-32-char-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=please-change-this-to-a-32-byte-base64-key

# ==============================================
# LLM（LiteLLM 格式）
# ==============================================
# 场景：chitchat / policy_query / ocr_post / contract_review
LLM_CHITCHAT_MODEL=gpt-4o-mini
LLM_CHITCHAT_API_KEY=
LLM_CHITCHAT_BASE_URL=https://api.openai.com/v1

LLM_POLICY_MODEL=gpt-4o
LLM_POLICY_API_KEY=
LLM_POLICY_BASE_URL=https://api.openai.com/v1

LLM_OCR_MODEL=gpt-4o
LLM_OCR_API_KEY=
LLM_OCR_BASE_URL=https://api.openai.com/v1

LLM_CONTRACT_MODEL=gpt-4o
LLM_CONTRACT_API_KEY=
LLM_CONTRACT_BASE_URL=https://api.openai.com/v1

# ==============================================
# OCR
# ==============================================
OCR_PROVIDER=tencent
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# ==============================================
# 公开财税检索（Chat 回答最新税率/总局公告/地区优惠）
# ==============================================
# 关闭时：公开财税问题不会编造数字，会提示未配置检索
# 管理端「工具配置」保存后以数据库为准（可覆盖本段）；未保存时仍读这些变量
WEB_SEARCH_ENABLED=false
# bocha（国内，推荐）| tavily
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=
# 留空则用提供商默认端点
# 博查: https://api.bochaai.com/v1/web-search
# Tavily: https://api.tavily.com/search
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=8
# 命中后抓取官方原文页数；0=不抓取（只用不摘要）
WEB_SEARCH_FETCH_PAGES=2
WEB_SEARCH_FETCH_MAX_CHARS=4000

# ==============================================
# Embedding（国内推荐通义 qwen3.7-text-embedding）
# ==============================================
# OpenAI: text-embedding-3-small + 1536
# 通义: qwen3.7-text-embedding + 1024（可选 2560/2048/1536/768/512/256）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

# ==============================================
# Milvus（企业级向量库，知识库主路径）
# ==============================================
MILVUS_ENABLED=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=finance_kb_chunks
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024
MILVUS_NPROBE=16
# 是否同时把向量写入 Postgres（仅降级备份，默认 false）
KB_STORE_PG_EMBEDDING=false

# ==============================================
# Celery
# ==============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ==============================================
# Langfuse（可选）
# ==============================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ==============================================
# 限流
# ==============================================
RATE_LIMIT_PER_USER=100/minute
RATE_LIMIT_PER_TENANT=10000/hour
RATE_LIMIT_PER_IP=1000/minute

# ==============================================
# 监控
# ==============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=grafana_admin_change_me