# 生产 Nginx：多阶段构建前端静态资源并托管；可选 TLS（见 docker-entrypoint.prod.sh）
FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# 同源部署：API 走相对路径 /api/v1
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine

RUN rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/certs

COPY nginx/nginx.prod.conf /etc/nginx/nginx.prod.conf
COPY nginx/nginx.prod.ssl.conf /etc/nginx/nginx.prod.ssl.conf
COPY nginx/docker-entrypoint.prod.sh /docker-entrypoint.prod.sh
RUN chmod +x /docker-entrypoint.prod.sh

COPY --from=frontend-build /app/dist /usr/share/nginx/html

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/nginx-health || exit 1

ENTRYPOINT ["/docker-entrypoint.prod.sh"]
